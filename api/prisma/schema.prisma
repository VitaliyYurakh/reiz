// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// EXISTING MODELS (preserved — do NOT modify existing columns)
// ============================================================

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  name              String   @default("")
  role              UserRole @default(manager)
  permissions       Json     @default("{}")
  isActive          Boolean  @default(true) @map("is_active")
  tokenVersion      Int      @default(0) @map("token_version")
  // ── 2FA (TOTP, opt-in) ─────────────────────────────────────────────
  // totpSecret: base32 secret, set during setup. Cleared on disable.
  // totpEnabled: only true after the user verifies their first code.
  // totpRecoveryCodes: array of bcrypt-hashed single-use codes (10 by
  //   default). Each is consumed when used. Stored hashed so a DB leak
  //   does not directly grant fallback access.
  totpSecret        String?  @map("totp_secret")
  totpEnabled       Boolean  @default(false) @map("totp_enabled")
  totpRecoveryCodes Json?    @map("totp_recovery_codes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  // CRM relations
  assignedRequests    RentalRequest[]    @relation("AssignedRequests")
  createdTransactions Transaction[]      @relation("CreatedTransactions")
  inspections         Inspection[]
  ratingAuthored      Client[]           @relation("RatingAuthor")
  auditLogs           AuditLog[]         @relation("AuditLogs")
  assignedComplaints  Complaint[]        @relation("AssignedComplaints")
  complaintMessages   ComplaintMessage[] @relation("ComplaintAuthorUser")
  assignedLeads       Lead[]             @relation("AssignedLeads")

  // Inventory / Accidents (added 2026-04 for CRM parity with mfauto)
  inventoryItems          InventoryItem[]    @relation("InventoryResponsible")
  reportedAccidents       Accident[]         @relation("AccidentReporter")
  carSwaps                RentalCarSwap[]    @relation("RentalCarSwapAuthor")
  documentTemplates       DocumentTemplate[] @relation("DocumentTemplateAuthor")
  partnerPaymentsAuthored PartnerPayment[]   @relation("PartnerPaymentAuthor")

  @@map("user")
}

model Car {
  id                Int     @id @default(autoincrement())
  brand             String?
  model             String?
  plateNumber       String? @map("plate_number")
  VIN               String? @map("vin")
  yearOfManufacture Int?    @map("year_of_manufacture")
  color             String?
  description       Json?
  previewUrl        String? @map("preview_url")
  engineVolume      String? @map("engine_volume")
  engineType        Json?   @map("engine_type")
  transmission      Json?
  fuelConsumption   String? @map("fuel_consumption")
  driveType         Json?   @map("drive_type")
  seats             Int?
  discount          Int?
  configuration     Json?
  isNew             Boolean @default(false) @map("is_new")
  isAvailable       Boolean @default(false) @map("is_available")

  deliveryPrice          Int?    @map("delivery_price")
  freeDeliveryThreshold  Int?    @map("free_delivery_threshold")
  cancellationHours      Int?    @map("cancellation_hours")
  paymentMethods         String? @map("payment_methods")
  minRentalDays          Int?    @map("min_rental_days")
  dailyMileageLimit      Int?    @map("daily_mileage_limit")
  overmileagePrice       Float?  @map("overmileage_price")
  driverAge              Int?    @map("driver_age")
  driverExperience       Int?    @map("driver_experience")
  fuelPolicy             String? @map("fuel_policy")
  weeklyMileageLimit     Int?    @map("weekly_mileage_limit")
  monthlyMileageLimit    Int?    @map("monthly_mileage_limit")
  unlimitedMileage       Boolean @default(false) @map("unlimited_mileage")
  maxRentalDays          Int?    @map("max_rental_days")
  allowCrossBorder       Boolean @default(false) @map("allow_cross_border")
  crossBorderFee         Int?    @map("cross_border_fee")
  crossBorderDailyFee    Int?    @map("cross_border_daily_fee")
  allowedCountries       Json?   @map("allowed_countries")
  lateReturnGraceMin     Int?    @map("late_return_grace_min")
  lateReturnFeePerHour   Float?  @map("late_return_fee_per_hour")
  youngerDriverAge       Int?    @map("younger_driver_age")
  youngerDriverSurcharge Float?  @map("younger_driver_surcharge")
  petAllowed             Boolean @default(false) @map("pet_allowed")
  cleaningFee            Int?    @map("cleaning_fee")

  // Additional services
  unlimitedMileagePrice1Day    Float?  @map("unlimited_mileage_price_1day")
  unlimitedMileagePrice2to7    Float?  @map("unlimited_mileage_price_2to7")
  unlimitedMileageFreeFromDays Int?    @map("unlimited_mileage_free_from_days")
  intercityDeliveryPrice       Float?  @map("intercity_delivery_price")
  carWashPrice                 Float?  @map("car_wash_price")
  emptyTankFee                 Float?  @map("empty_tank_fee")
  additionalDriverFee          Float?  @map("additional_driver_fee")
  equipmentRentalPrice         Float?  @map("equipment_rental_price")
  afterHoursServiceFee         Float?  @map("after_hours_service_fee")
  workingHoursStart            String? @map("working_hours_start")
  workingHoursEnd              String? @map("working_hours_end")

  // Damage fees
  damageTiresFee         Float? @map("damage_tires_fee")
  damageGlassChipFee     Float? @map("damage_glass_chip_fee")
  damageLostKeysFee      Float? @map("damage_lost_keys_fee")
  damageBrokenGlassFee   Float? @map("damage_broken_glass_fee")
  damageTotalLossPercent Float? @map("damage_total_loss_percent")
  damageScratchesFee     Float? @map("damage_scratches_fee")
  damageSmokingFee       Float? @map("damage_smoking_fee")
  depositMultiplier      Float? @map("deposit_multiplier")

  // Partner / owner — for fleet operated under commission with another business
  partnerId Int? @map("partner_id")

  rentalTariff    RentalTariff[]
  carPhoto        CarPhoto[]
  carCountingRule CarCountingRule[]
  segment         Segment[]

  // Operational status (admin can hard-block a vehicle from rentals — separate
  // from `isAvailable` which gates the public catalog).
  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason")

  // Mileage-based scheduled maintenance (parity with mfauto «Регламентні роботи»)
  currentOdometer      Int?      @map("current_odometer")
  serviceIntervalKm    Int?      @map("service_interval_km")
  nextServiceMileageKm Int?      @map("next_service_mileage_km")
  lastServiceAt        DateTime? @map("last_service_at")
  lastServiceMileageKm Int?      @map("last_service_mileage_km")

  // CRM relations (no DB column changes)
  rentalRequests RentalRequest[]
  reservations   Reservation[]
  rentals        Rental[]
  ratePlans      RatePlan[]
  serviceEvents  ServiceEvent[]

  // City availability
  cityAvailability CarCityAvailability[]

  // Customer cabinet relations
  favorites Favorite[]

  // Accident/ДТП history + car-swap targets
  accidents Accident[]      @relation("AccidentCar")
  swapsFrom RentalCarSwap[] @relation("CarSwapFrom")
  swapsTo   RentalCarSwap[] @relation("CarSwapTo")

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([isBlocked])
  @@map("car")
}

model Segment {
  id               Int    @id @default(autoincrement())
  name             String
  description      String
  overmileagePrice Float  @map("overmileage_price")
  driverAge        Int    @default(25) @map("driver_age")
  experience       Int    @default(3)

  car Car[]

  @@map("segment")
}

model RentalTariff {
  id         Int @id @default(autoincrement())
  deposit    Int
  minDays    Int @map("min_days")
  maxDays    Int @map("max_days")
  dailyPrice Int @map("daily_price")
  carId      Int @map("car_id")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([minDays, maxDays, carId])
  @@map("rental_tariff")
}

model CarCountingRule {
  id             Int  @id @default(autoincrement())
  pricePercent   Int  @map("price_percent")
  depositPercent Int  @map("deposit_percent")
  priceFixed     Int? @map("price_fixed")
  priceFixed30   Int? @map("price_fixed_30")
  depositFixed   Int? @map("deposit_fixed")
  carId          Int  @map("car_id")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_counting_rule")
}

model CarPhoto {
  id    Int          @id @default(autoincrement())
  type  CarPhotoType
  url   String
  carId Int          @map("car_id")
  alt   String

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_photo")
}

enum CarPhotoType {
  MOBILE
  PC
}

/// @deprecated as of 2026-05-01. Public booking forms now write directly
/// to `RentalRequest` (with `source='website'` and the booking payload
/// stored in `websiteSnapshot`). This table is kept for the historical
/// rows created before that change — `seed.ts` migrates any orphans to
/// RentalRequest on container start. New code should not write here.
model BookingRequest {
  id             Int      @id @default(autoincrement())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String
  email          String
  pickupLocation String   @map("pickup_location")
  returnLocation String   @map("return_location")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  flightNumber   String?  @map("flight_number")
  comment        String?
  carId          Int?     @map("car_id")
  clientId       Int?     @map("client_id")
  carDetails     Json?    @map("car_details")
  selectedPlan   Json?    @map("selected_plan")
  selectedExtras Json?    @map("selected_extras")
  totalDays      Int?     @map("total_days")
  priceBreakdown Json?    @map("price_breakdown")
  telegramSent   Boolean  @default(false) @map("telegram_sent")
  createdAt      DateTime @default(now()) @map("created_at")

  // CRM relation
  client        Client?        @relation(fields: [clientId], references: [id])
  rentalRequest RentalRequest?

  @@map("booking_request")
}

model ContactRequest {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String
  message      String?
  telegramSent Boolean  @default(false) @map("telegram_sent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("contact_request")
}

model CallbackRequest {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  contactMethod String?  @map("contact_method")
  telegramSent  Boolean  @default(false) @map("telegram_sent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("callback_request")
}

model BusinessRequest {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  email        String
  message      String?
  telegramSent Boolean  @default(false) @map("telegram_sent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("business_request")
}

// ============================================================
// NEW CRM MODELS
// ============================================================

// --- Enums ---
//
// Every enum's value list is the source of truth — Postgres rejects any
// INSERT/UPDATE that doesn't match (a typo like `'avtive'` no longer
// silently sits in a status column). Mirrors the TS-side const-objects
// in `app/utils/constants.ts`; they stay around for centralized labels
// + iteration helpers (LEAD_ACTIVE_STATUSES etc.) but the canonical
// shape now lives here.

enum AddOnPricingMode {
  PER_DAY
  ONE_TIME
  MANUAL_QTY
}

enum ReservationStatus {
  confirmed
  picked_up
  cancelled
  no_show
}

enum RentalStatus {
  active
  completed
  cancelled
}

// Matches what `rental-request.service` actually writes today: new
// rows start as 'new', admin moves them to 'in_review' while triaging,
// then to 'approved' / 'rejected' / 'cancelled'. The `'pending'` value
// in `constants.ts.RentalRequestStatus.PENDING` was aspirational and
// never actually persisted — left out of the enum to keep the runtime
// values authoritative.
enum RentalRequestStatus {
  new
  in_review
  approved
  rejected
  cancelled
}

enum AccountType {
  CASH
  BANK_ACCOUNT
  BANK_CARD
}

// Currencies the platform handles. UAH/USD/EUR are the real money flows;
// ILS/PLN are accepted by validators for international clients;
// GBP/CZK/RON exist because fxRateService caches their NBU rates for
// reference even though we don't transact in them. Keeping all 8 in one
// enum means daily_fx_rate.currency can store any of the 6 SUPPORTED
// fetched rates without runtime ENUM rejection.
enum Currency {
  UAH
  USD
  EUR
  ILS
  PLN
  GBP
  CZK
  RON
}

enum TransactionType {
  PAYMENT
  DEPOSIT_RECEIVED
  DEPOSIT_RETURNED
  REFUND
  FINE_PAYMENT
  SERVICE_COST
  ADDON_PAYMENT
  EXTENSION_PAYMENT
  PARTNER_COMMISSION
  TRANSFER
}

enum TransactionDirection {
  in
  out
}

enum LeadStatus {
  NEW
  ENRICHED
  READY
  CONTACTED
  FOLLOWED_UP_1
  FOLLOWED_UP_2
  BREAKUP_SENT
  REPLIED
  INTERESTED
  CLIENT
  DISQUALIFIED
  BOUNCED
  UNSUBSCRIBED
  PAUSED
}

enum LeadEmailDirection {
  OUTBOUND
  INBOUND
}

enum AccidentFault {
  CLIENT
  COMPANY
  THIRD_PARTY
  UNKNOWN
}

enum AccidentStatus {
  REPORTED
  INVESTIGATING
  AWAITING_PAYOUT
  RESOLVED
  CLOSED
}

enum InventoryCategory {
  TOOL
  EQUIPMENT
  ACCESSORY
  KEYS
  OTHER
}

enum InventoryStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  WRITTEN_OFF
}

enum RentalDepositStatus {
  PENDING
  RECEIVED
  RETURNED
  FORFEITED
}

enum PartnerPaymentStatus {
  paid
  partial
  disputed
  refunded
}

enum ComplaintCategory {
  DEPOSIT
  DAMAGE
  FINE
  SERVICE
  GDPR
  OTHER
}

enum ComplaintPriority {
  low
  normal
  high
  urgent
}

enum ComplaintStatus {
  open
  in_review
  awaiting_client
  resolved
  rejected
}

enum ComplaintAuthorType {
  client
  staff
  system
}

enum DocumentTemplateKind {
  RENTAL_AGREEMENT
  ACT_TRANSFER
  ACT_RETURN
  INVOICE
  INSURANCE_CLAIM
  OTHER
}

enum FxRateSource {
  NBU
  manual
}

// 'operator' is allowed by the createUser validator but no production user
// currently has it; included so signup with role=operator doesn't get
// rejected at the DB layer.
enum UserRole {
  admin
  manager
  operator
}

enum ServiceEventType {
  MAINTENANCE
  REPAIR
  INSURANCE_RENEWAL
  INSPECTION_GOV
  WASH
  OTHER
}

enum InspectionType {
  PICKUP
  RETURN
}

enum FineType {
  OVERMILEAGE
  DAMAGE
  LATE_RETURN
  FUEL
  CLEANING
  TRAFFIC
  ACCIDENT
  OTHER
}

// --- Client ---

model Client {
  id                    Int       @id @default(autoincrement())
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  middleName            String?   @map("middle_name")
  phone                 String
  email                 String?
  dateOfBirth           DateTime? @map("date_of_birth")
  drivingSince          Int?      @map("driving_since")
  languages             Json?
  driverLicenseNo       String?   @map("driver_license_no")
  driverLicenseExpiry   DateTime? @map("driver_license_exp")
  passportNo            String?   @map("passport_no")
  nationalId            String?   @map("national_id")
  address               String?
  city                  String?
  country               String    @default("UA")
  notes                 String?
  rating                Int?
  ratingReason          String?   @map("rating_reason")
  ratingAuthorId        Int?      @map("rating_author_id")
  source                String?
  isBlocked             Boolean   @default(false) @map("is_blocked")
  blockReason           String?   @map("block_reason")
  blockedAt             DateTime? @map("blocked_at")
  loyaltyTier           String?   @map("loyalty_tier")
  totalCompletedRentals Int       @default(0) @map("total_completed_rentals")
  totalSpentMinor       Int       @default(0) @map("total_spent_minor")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  ratingAuthor    User?            @relation("RatingAuthor", fields: [ratingAuthorId], references: [id])
  documents       ClientDocument[]
  bookingRequests BookingRequest[]
  rentalRequests  RentalRequest[]
  reservations    Reservation[]
  rentals         Rental[]
  transactions    Transaction[]

  // Customer cabinet relations
  customerAccount        CustomerAccount?
  favorites              Favorite[]
  notificationPreference NotificationPreference?

  // Complaint relations
  complaints Complaint[]

  // Accidents where this client was the driver/at-fault party
  accidents Accident[]

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@index([isBlocked])
  @@map("client")
}

model ClientDocument {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  type       String
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_document")
}

// --- Rental Request (Lead) ---

model RentalRequest {
  id               Int                 @id @default(autoincrement())
  source           String              @default("website")
  status           RentalRequestStatus @default(new)
  clientId         Int?                @map("client_id")
  bookingRequestId Int?                @unique @map("booking_request_id")
  carId            Int?                @map("car_id")

  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phone          String?
  email          String?
  pickupLocation String?   @map("pickup_location")
  returnLocation String?   @map("return_location")
  pickupDate     DateTime? @map("pickup_date")
  returnDate     DateTime? @map("return_date")
  flightNumber   String?   @map("flight_number")
  comment        String?

  websiteSnapshot Json?   @map("website_snapshot")
  rejectionReason String? @map("rejection_reason")

  assignedToUserId Int? @map("assigned_to_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client         Client?         @relation(fields: [clientId], references: [id])
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  car            Car?            @relation(fields: [carId], references: [id])
  assignedTo     User?           @relation("AssignedRequests", fields: [assignedToUserId], references: [id])
  reservation    Reservation?

  @@index([status])
  @@index([clientId])
  @@index([carId])
  @@index([createdAt])
  @@map("rental_request")
}

// --- Catalogs ---

model CoveragePackage {
  id             Int       @id @default(autoincrement())
  name           String
  nameLocalized  Json?     @map("name_localized")
  depositPercent Int       @map("deposit_percent")
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  reservations Reservation[]

  @@index([isActive])
  @@map("coverage_package")
}

model AddOn {
  id             Int              @id @default(autoincrement())
  name           String
  nameLocalized  Json?            @map("name_localized")
  pricingMode    AddOnPricingMode @map("pricing_mode")
  unitPriceMinor Int              @map("unit_price_minor")
  currency       Currency         @default(USD)
  defaultQty     String?          @map("default_qty")
  qtyEditable    Boolean          @default(false) @map("qty_editable")
  isActive       Boolean          @default(true) @map("is_active")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  reservationAddOns ReservationAddOn[]
  rentalAddOns      RentalAddOn[]

  @@index([isActive])
  @@map("add_on")
}

model RatePlan {
  id         Int       @id @default(autoincrement())
  name       String
  carId      Int       @map("car_id")
  minDays    Int       @map("min_days")
  maxDays    Int       @map("max_days")
  dailyPrice Int       @map("daily_price")
  currency   Currency  @default(USD)
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, isActive])
  @@index([deletedAt])
  @@map("rate_plan")
}

// --- Reservation ---

model Reservation {
  id                Int               @id @default(autoincrement())
  status            ReservationStatus @default(confirmed)
  rentalRequestId   Int?              @unique @map("rental_request_id")
  clientId          Int               @map("client_id")
  carId             Int               @map("car_id")
  coveragePackageId Int?              @map("coverage_package_id")

  pickupLocation String   @map("pickup_location")
  returnLocation String   @map("return_location")
  pickupDate     DateTime @map("pickup_date")
  returnDate     DateTime @map("return_date")

  priceSnapshot    Json     @map("price_snapshot")
  deliveryFee      Int      @default(0) @map("delivery_fee")
  deliveryCurrency Currency @default(UAH) @map("delivery_currency")

  cancelReason              String?   @map("cancel_reason")
  cancelledAt               DateTime? @map("cancelled_at")
  noShowAt                  DateTime? @map("no_show_at")
  cancellationRequestedAt   DateTime? @map("cancellation_requested_at")
  cancellationRequestReason String?   @map("cancellation_request_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rentalRequest     RentalRequest?     @relation(fields: [rentalRequestId], references: [id])
  client            Client             @relation(fields: [clientId], references: [id])
  car               Car                @relation(fields: [carId], references: [id])
  coveragePackage   CoveragePackage?   @relation(fields: [coveragePackageId], references: [id])
  rental            Rental?
  reservationAddOns ReservationAddOn[]
  transactions      Transaction[]

  @@index([status])
  @@index([carId, pickupDate, returnDate])
  @@index([clientId])
  @@index([pickupDate])
  @@index([returnDate])
  @@map("reservation")
}

model ReservationAddOn {
  id             Int      @id @default(autoincrement())
  reservationId  Int      @map("reservation_id")
  addOnId        Int      @map("add_on_id")
  quantity       Int      @default(1)
  unitPriceMinor Int      @map("unit_price_minor")
  currency       Currency @default(USD)
  totalMinor     Int      @map("total_minor")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  addOn       AddOn       @relation(fields: [addOnId], references: [id])

  @@map("reservation_add_on")
}

// --- Rental ---

model Rental {
  id             Int          @id @default(autoincrement())
  status         RentalStatus @default(active)
  reservationId  Int?         @unique @map("reservation_id")
  clientId       Int          @map("client_id")
  carId          Int          @map("car_id")
  contractNumber String?      @unique @map("contract_number")

  pickupDate       DateTime  @map("pickup_date")
  returnDate       DateTime  @map("return_date")
  actualReturnDate DateTime? @map("actual_return_date")

  pickupLocation String @map("pickup_location")
  returnLocation String @map("return_location")

  pickupOdometer Int? @map("pickup_odometer")
  returnOdometer Int? @map("return_odometer")
  allowedMileage Int? @map("allowed_mileage")

  priceSnapshot Json @map("price_snapshot")

  depositAmount   Int      @default(0) @map("deposit_amount")
  depositCurrency Currency @default(UAH) @map("deposit_currency")
  depositReturned Boolean  @default(false) @map("deposit_returned")

  cancelReason              String?   @map("cancel_reason")
  cancellationRequestedAt   DateTime? @map("cancellation_requested_at")
  cancellationRequestReason String?   @map("cancellation_request_reason")
  notes                     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservation      Reservation?      @relation(fields: [reservationId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id])
  car              Car               @relation(fields: [carId], references: [id])
  rentalAddOns     RentalAddOn[]
  rentalExtensions RentalExtension[]
  inspections      Inspection[]
  fines            Fine[]
  transactions     Transaction[]
  documents        Document[]
  complaints       Complaint[]

  // Accidents that happened during this rental
  accidents           Accident[]
  // History of mid-rental car swaps (latest record's `toCarId` matches `carId`)
  carSwaps            RentalCarSwap[]
  // Dynamic deposits (per-rental ad-hoc holds beyond the standard depositAmount)
  rentalDeposits      RentalDeposit[]
  // Which monthly partner-payments cover this rental (one rental → many
  // payment rows possible if a correction is issued).
  partnerPaymentLinks PartnerPaymentRental[]

  @@index([status])
  @@index([carId, pickupDate, returnDate])
  @@index([clientId])
  @@index([contractNumber])
  @@map("rental")
}

