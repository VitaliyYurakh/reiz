  createdAt DateTime @default(now()) @map("created_at")

  transactions   Transaction[]
  PartnerPayment PartnerPayment[]

  @@map("account")
}

model Transaction {
  id             Int                  @id @default(autoincrement())
  type           TransactionType
  accountId      Int                  @map("account_id")
  direction      TransactionDirection
  amountMinor    Int                  @map("amount_minor")
  currency       Currency
  fxRate         Float                @default(1.0) @map("fx_rate")
  amountUahMinor Int                  @map("amount_uah_minor")
  description    String?

  clientId        Int? @map("client_id")
  reservationId   Int? @map("reservation_id")
  rentalId        Int? @map("rental_id")
  fineId          Int? @unique @map("fine_id")
  // For income tagged as a partner commission settlement (type =
  // PARTNER_COMMISSION). Allows revenue/partner reports to roll up by partner.
  partnerId       Int? @map("partner_id")
  createdByUserId Int? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Inter-account transfer link: outgoing and incoming legs reference each other
  // so the UI can render a paired badge and reports can de-double them in totals.
  transferPairId Int?         @unique @map("transfer_pair_id")
  transferPair   Transaction? @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf Transaction? @relation("TransferPair")

  account     Account      @relation(fields: [accountId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  rental      Rental?      @relation(fields: [rentalId], references: [id])
  fine        Fine?        @relation(fields: [fineId], references: [id])
  partner     Partner?     @relation("PartnerTransactions", fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CreatedTransactions", fields: [createdByUserId], references: [id])

  // Back-relations for RentalDeposit (paired txn for received / returned)
  depositReceivedFor RentalDeposit?  @relation("DepositReceivedTxn")
  depositReturnedFor RentalDeposit?  @relation("DepositReturnedTxn")
  // Back-relation for PartnerPayment (the payment row this transaction settles)
  partnerPaymentFor  PartnerPayment?

  @@index([accountId])
  @@index([clientId])
  @@index([rentalId])
  @@index([reservationId])
  @@index([partnerId])
  @@index([createdAt])
  @@index([type])
  @@map("transaction")
}

