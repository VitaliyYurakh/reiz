// ============================================================
// COMPLAINTS & DISPUTES (added 2026-04)
// ============================================================
//
// Replaces ad-hoc support emails. A Complaint is the canonical record of any
// customer dispute, complaint, or refund request — with attachments, a thread,
// SLA tracking, and an assigned manager. Lets us:
//   * defend disputed deductions with evidence + audit trail
//   * meet GDPR data-subject requests with a numbered case
//   * surface friction patterns in admin (status filters, by category)

model Complaint {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique @map("ticket_number") // human-friendly e.g. "REIZ-COMP-2026-04-0001"
  clientId          Int?              @map("client_id") // nullable — anonymous via contact form is OK
  rentalId          Int?              @map("rental_id")
  category          ComplaintCategory
  priority          ComplaintPriority @default(normal)
  status            ComplaintStatus   @default(open)
  subject           String
  initialMessage    String            @map("initial_message")
  contactName       String?           @map("contact_name")
  contactEmail      String?           @map("contact_email")
  contactPhone      String?           @map("contact_phone")
  attachments       Json              @default("[]") // array of URLs
  assignedManagerId Int?              @map("assigned_manager_id")
  slaDeadline       DateTime?         @map("sla_deadline")
  resolvedAt        DateTime?         @map("resolved_at")
  resolution        String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rental          Rental?            @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  assignedManager User?              @relation("AssignedComplaints", fields: [assignedManagerId], references: [id])
  messages        ComplaintMessage[]

  @@index([status])
  @@index([category])
  @@index([clientId])
  @@index([rentalId])
  @@index([assignedManagerId])
  @@index([createdAt])
  @@map("complaint")
}

model ComplaintMessage {
  id           Int                 @id @default(autoincrement())
  complaintId  Int                 @map("complaint_id")
  authorType   ComplaintAuthorType @map("author_type")
  authorUserId Int?                @map("author_user_id")
  body         String
  attachments  Json                @default("[]")
  createdAt    DateTime            @default(now()) @map("created_at")

  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorUser User?     @relation("ComplaintAuthorUser", fields: [authorUserId], references: [id])

  @@index([complaintId])
  @@map("complaint_message")
}

// ============================================================
// DAILY FX RATE (added 2026-04)
// ============================================================
//
// Stops cashiers from typing different USD/UAH rates in the same day.
// Pulled from НБУ once a day (cron) and used as default when creating
// non-UAH transactions; can still be overridden manually with a note.

model DailyFxRate {
  id        Int          @id @default(autoincrement())
  date      DateTime     @db.Date
  currency  Currency
  rate      Float // units of UAH per 1 unit of currency
  source    FxRateSource @default(NBU)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([date, currency])
  @@index([currency, date])
  @@map("daily_fx_rate")
}

// ============================================================
// PARTNERS (added 2026-04)
// ============================================================
//
// External owners whose cars Reiz manages on commission. Each Partner has
// commission tiers based on rental length (default 15% / 12.5% / 10% for
// short / mid / long rentals — matches the partner statement template the
// company has been sending manually as XLSX). Reports are generated per
// partner per period and exported as XLSX.

model Partner {
  id              Int      @id @default(autoincrement())
  fullName        String   @map("full_name")
  companyName     String?  @map("company_name")
  edrpou          String? // ЄДРПОУ / company tax ID for VAT-compliant invoices
  ipn             String? // ІПН / personal tax ID for individuals
  phone           String?
  email           String?
  iban            String? // for payouts
  bankName        String?  @map("bank_name")
  // Default commission tiers as JSON: [{minDays: 1, maxDays: 7, percent: 15}, ...]
  // Stored as Json so we can evolve the rule shape without migrations.
  commissionTiers Json     @default("[{\"minDays\":1,\"maxDays\":7,\"percent\":15},{\"minDays\":8,\"maxDays\":29,\"percent\":12.5},{\"minDays\":30,\"maxDays\":0,\"percent\":10}]") @map("commission_tiers")
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cars         Car[]
  payments     PartnerPayment[]
  // Inbound transactions tagged with this partner (commission settlements).
  transactions Transaction[]    @relation("PartnerTransactions")

  @@index([isActive])
  @@map("partner")
}

// ============================================================
// PARTNER MONTHLY SETTLEMENTS — added 2026-04-29
// ============================================================
//
// Records the actual transfer the operator received from a partner at the
// end of each month — closes the loop on the rentals listed in
// partner.service.getReport(). Stores both the calculated commission
// (`amountEurMinor` / `expectedUahMinor`) and the amount that actually hit
// the bank account (`receivedUahMinor`) — partners often round, so a
// small variance is normal and tracked, not silently overwritten.
//
// Each row is paired with a single Transaction (income, type =
// PARTNER_COMMISSION) on the manager's chosen account, and links to every
// Rental that's covered by this payment via the join table
// `partner_payment_rental` so the partner statement can render a
// "✓ оплачено DD.MM" badge per rental.

model PartnerPayment {
  id Int @id @default(autoincrement())

  partnerId  Int      @map("partner_id")
  // Reporting period covered by this payment (operator picks "April 2026" etc).
  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  // Calculated commission for the period (sum of `commissionAmount` over
  // the rentals in this period, in EUR cents).
  amountEurMinor   Int   @map("amount_eur_minor")
  // What that EUR sum was worth in UAH at the time the operator generated
  // the statement (NBU rate, weighted by rental). Stored for audit so we can
  // show "очікувалося ₴X" alongside actual receipt.
  expectedUahMinor Int   @map("expected_uah_minor")
  // What actually landed on the bank account in UAH cents. Operator can
  // override before saving (rounding, partial pay, etc).
  receivedUahMinor Int   @map("received_uah_minor")
  // FX rate used to compute expectedUahMinor (UAH per 1 EUR). Captured for
  // historical audit — recomputing later won't drift.
  fxRate           Float @map("fx_rate")

  // Operator chooses which account the funds landed on (typically Monobank
  // UAH). Account currency is informational only — the amount on the
  // transaction is always UAH for partner payments.
  accountId     Int  @map("account_id")
  // The Transaction this payment created. One PartnerPayment ⟷ one Transaction.
  // Nullable to allow the row to be inserted first, then back-linked.
  transactionId Int? @unique @map("transaction_id")

  paidAt      DateTime             @map("paid_at")
  status      PartnerPaymentStatus @default(paid)
  notes       String?
  createdById Int?                 @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner     Partner                @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  account     Account                @relation(fields: [accountId], references: [id])
  transaction Transaction?           @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("PartnerPaymentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  rentals     PartnerPaymentRental[]

  @@index([partnerId, periodFrom])
  @@index([paidAt])
  @@map("partner_payment")
}

// Join table — which rentals are settled by which payment. A rental can
// theoretically appear in multiple payments (corrections / reissues), so
// no unique constraint on (rentalId).
model PartnerPaymentRental {
  id               Int @id @default(autoincrement())
  partnerPaymentId Int @map("partner_payment_id")
  rentalId         Int @map("rental_id")

  // Snapshot of the per-rental commission at the moment the payment was
  // settled — protects against later edits to the rental's priceSnapshot
  // shifting the historical attribution.
  commissionEurMinor Int @map("commission_eur_minor")

  payment PartnerPayment @relation(fields: [partnerPaymentId], references: [id], onDelete: Cascade)
  rental  Rental         @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  @@unique([partnerPaymentId, rentalId])
  @@index([rentalId])
  @@map("partner_payment_rental")
}

// ============================================================
// B2B OUTREACH — LEADS (added 2026-04)
// ============================================================
//
// External car-rental businesses we cold-email to pitch the REIZ
// white-label SaaS platform. Lead lifecycle:
//   NEW → ENRICHED (email parsed) → READY → CONTACTED →
//     FOLLOWED_UP_1 (3d) → FOLLOWED_UP_2 (7d) → BREAKUP_SENT (14d)
// Exit branches at any point: REPLIED, INTERESTED, CLIENT,
//   DISQUALIFIED, BOUNCED, UNSUBSCRIBED, PAUSED.
// LeadEmail keeps both inbound and outbound messages so the admin
// shows a chronological thread per lead.

model Lead {
  id Int @id @default(autoincrement())

  source        String  @default("google_places") // 'google_places' | 'manual' | 'csv'
  googlePlaceId String? @unique @map("google_place_id")

  companyName String  @map("company_name")
  country     String // ISO-2: 'TR' | 'ME' | 'RS' | 'AM' | 'TH' | 'ID' | 'KZ'
  city        String
  website     String?
  phone       String?
  email       String?
  ownerName   String? @map("owner_name")

  language String @default("ru") // outreach language: 'ru' | 'en' | 'tr' | 'sr' | ...

  status       LeadStatus @default(NEW)
  pausedReason String?    @map("paused_reason")

  // Cached website excerpt — fed to Gemini for personalization. Limited to ~2000 chars in code.
  websiteContent String? @map("website_content") @db.Text

  contactedAt    DateTime? @map("contacted_at")
  lastFollowUpAt DateTime? @map("last_follow_up_at")
  followUpCount  Int       @default(0) @map("follow_up_count")
  repliedAt      DateTime? @map("replied_at")

  assignedManagerId Int?    @map("assigned_manager_id")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedManager User?       @relation("AssignedLeads", fields: [assignedManagerId], references: [id])
  emails          LeadEmail[]

  @@index([status])
  @@index([country])
  @@index([assignedManagerId])
  @@index([createdAt])
  @@index([contactedAt])
  @@map("lead")
}

model LeadEmail {
  id     Int @id @default(autoincrement())
  leadId Int @map("lead_id")

  direction LeadEmailDirection
  template  String? // 'initial' | 'fu_3d' | 'fu_7d' | 'breakup_14d' | null
  subject   String
  body      String             @db.Text

  sentAt     DateTime? @map("sent_at")
  receivedAt DateTime? @map("received_at")

  // Gmail tracking — used both to deduplicate inbound messages and to thread
  // follow-ups under the same conversation in the recipient's mailbox.
  gmailMsgId    String? @unique @map("gmail_msg_id")
  gmailThreadId String? @map("gmail_thread_id")

  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([direction])
  @@index([gmailThreadId])
  @@map("lead_email")
}

// ─── Mail (general inbox at /admin/mail) ──────────────────────────────────
// IMAP/SMTP-backed inbox. Designed to support multiple accounts but bootstraps
// a single account from MAIL_* env vars on first sync. Credentials live in env
// (not in DB) so no encryption layer is needed at this stage.

model MailAccount {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  displayName String?   @map("display_name")
  imapHost    String    @map("imap_host")
  imapPort    Int       @default(993) @map("imap_port")
  imapSecure  Boolean   @default(true) @map("imap_secure")
  smtpHost    String    @map("smtp_host")
  smtpPort    Int       @default(465) @map("smtp_port")
  smtpSecure  Boolean   @default(true) @map("smtp_secure")
  username    String // login (often = email)
  signature   String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  folders  MailFolder[]
  messages MailMessage[]
  drafts   MailDraft[]

  @@map("mail_account")
}

model MailFolder {
  id          Int       @id @default(autoincrement())
  accountId   Int       @map("account_id")
  path        String // IMAP path, e.g. "INBOX", "Sent"
  name        String // display name
  specialUse  String?   @map("special_use") // \Inbox \Sent \Drafts \Trash \Junk
  uidValidity String?   @map("uid_validity") // BigInt as string
  uidNext     String?   @map("uid_next")
  unreadCount Int       @default(0) @map("unread_count")
  totalCount  Int       @default(0) @map("total_count")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account  MailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages MailMessage[]

  @@unique([accountId, path])
  @@index([accountId])
  @@map("mail_folder")
}

model MailMessage {
  id             Int      @id @default(autoincrement())
  accountId      Int      @map("account_id")
  folderId       Int      @map("folder_id")
  uid            Int // IMAP UID within folder
  messageId      String?  @map("message_id") // RFC Message-ID
  inReplyTo      String?  @map("in_reply_to")
  references     String?  @db.Text
  threadKey      String?  @map("thread_key")
  fromName       String?  @map("from_name")
  fromAddr       String   @map("from_addr")
  toAddrs        Json     @map("to_addrs")
  ccAddrs        Json?    @map("cc_addrs")
  bccAddrs       Json?    @map("bcc_addrs")
  replyTo        Json?    @map("reply_to")
  subject        String?  @db.Text
  date           DateTime
  bodyText       String?  @map("body_text") @db.Text
  bodyHtml       String?  @map("body_html") @db.Text
  snippet        String?  @db.Text // first ~200 chars
  hasAttachments Boolean  @default(false) @map("has_attachments")
  size           Int?
  isSeen         Boolean  @default(false) @map("is_seen")
  isFlagged      Boolean  @default(false) @map("is_flagged")
  isAnswered     Boolean  @default(false) @map("is_answered")
  isDraft        Boolean  @default(false) @map("is_draft")
  flags          Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account     MailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder      MailFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  attachments MailAttachment[]

  @@unique([accountId, folderId, uid])
  @@index([accountId, folderId, date])
  @@index([threadKey])
  @@index([fromAddr])
  @@index([isSeen])
  @@map("mail_message")
}

model MailAttachment {
  id          Int      @id @default(autoincrement())
  messageId   Int      @map("message_id")
  filename    String?
  contentType String?  @map("content_type")
  size        Int?
  contentId   String?  @map("content_id") // for inline cid: refs
  partId      String?  @map("part_id") // IMAP part for on-demand fetch
  storagePath String?  @map("storage_path") // disk cache
  createdAt   DateTime @default(now()) @map("created_at")

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("mail_attachment")
}

model MailDraft {
  id          Int      @id @default(autoincrement())
  accountId   Int      @map("account_id")
  toAddrs     Json     @map("to_addrs")
  ccAddrs     Json?    @map("cc_addrs")
  bccAddrs    Json?    @map("bcc_addrs")
  subject     String?  @db.Text
  bodyHtml    String?  @map("body_html") @db.Text
  bodyText    String?  @map("body_text") @db.Text
  inReplyToId Int?     @map("in_reply_to_id") // MailMessage we're replying to
  attachments Json? // [{filename, path, size, type}] — pending uploads
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("mail_draft")
}

// ============================================================
// CRM PARITY EXTENSIONS — added 2026-04-28
// (Accident / Inventory / DocumentTemplate / RentalCarSwap /
//  RentalDeposit) — patterned on competitor mfauto.ua so the
// admin reaches feature parity for fleet operations.
// ============================================================

// --- Accident / ДТП ---
//
// One row per insurance-relevant event involving a fleet car. The car gets
// auto-blocked from new rentals on creation and unblocked when status moves
// to RESOLVED or CLOSED (handled in service layer, not by the schema).
//
// `fault` drives whether the client gets a Fine: CLIENT → fine equal to
// uninsured loss; THIRD_PARTY → expect insurance payout; UNKNOWN/COMPANY →
// neither. Status flow: REPORTED → INVESTIGATING → AWAITING_PAYOUT → RESOLVED.

model Accident {
  id Int @id @default(autoincrement())

  carId          Int  @map("car_id")
  rentalId       Int? @map("rental_id") // optional — accident may happen off-rental
  clientId       Int? @map("client_id") // driver at the time
  reporterUserId Int? @map("reporter_user_id")

  incidentAt  DateTime @map("incident_at")
  reportedAt  DateTime @default(now()) @map("reported_at")
  location    String?
  description String

  fault  AccidentFault  @default(UNKNOWN)
  status AccidentStatus @default(REPORTED)

  policeReportNumber   String? @map("police_report_number")
  insuranceCompany     String? @map("insurance_company")
  insuranceClaimNumber String? @map("insurance_claim_number")

  // Expert visit (страхова експертиза)
  expertVisitAt DateTime? @map("expert_visit_at")
  expertNotes   String?   @map("expert_notes")

  // Money — minor units (kopecks/cents). Currency same on all 3 fields per case.
  estimatedDamageMinor Int?     @map("estimated_damage_minor")
  insurancePayoutMinor Int?     @map("insurance_payout_minor")
  clientDebtMinor      Int      @default(0) @map("client_debt_minor")
  currency             Currency @default(UAH)

  // When true → Car.isBlocked is forced true while the case is open.
  blocksCar Boolean @default(true) @map("blocks_car")

  // Linked Fine row created when fault=CLIENT (so the debt feeds into the
  // existing fine ledger and doesn't need a separate accounting path).
  linkedFineId Int? @unique @map("linked_fine_id")

  // Free-form attachments (URLs to photos, expert reports, police docs).
  attachments Json    @default("[]")
  notes       String?

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  car        Car     @relation("AccidentCar", fields: [carId], references: [id], onDelete: Restrict)
  rental     Rental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reporter   User?   @relation("AccidentReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  linkedFine Fine?   @relation(fields: [linkedFineId], references: [id], onDelete: SetNull)

  @@index([carId, incidentAt])
  @@index([rentalId])
  @@index([clientId])
  @@index([status])
  @@map("accident")
}

// --- Inventory item (tools / equipment / accessories) ---
//
// Tracks physical items (impact wrenches, jump-starters, child seats, GPS
// trackers, keys, fuel cans) that are NOT a Car and NOT a consumable part —
// each is a unique trackable asset assigned to a person. For consumable
// parts/spares use a separate stock table (not in scope here).

model InventoryItem {
  id Int @id @default(autoincrement())

  name               String
  category           InventoryCategory @default(TOOL)
  serialNumber       String?           @unique @map("serial_number")
  status             InventoryStatus   @default(AVAILABLE)
  quantity           Int               @default(1)
  purchaseDate       DateTime?         @map("purchase_date")
  purchasePriceMinor Int?              @map("purchase_price_minor")
  currentValueMinor  Int?              @map("current_value_minor")
  currency           Currency          @default(UAH)

  // Where the item normally lives (a pickup location / warehouse).
  locationId        Int?      @map("location_id")
  // Who is currently responsible for it.
  responsibleUserId Int?      @map("responsible_user_id")
  // When the item was checked out to the responsible person.
  assignedAt        DateTime? @map("assigned_at")

  notes       String?
  attachments Json    @default("[]") // URLs (photos, receipts)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location        PickupLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  responsibleUser User?           @relation("InventoryResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([locationId])
  @@index([responsibleUserId])
  @@map("inventory_item")
}

// --- Document template (договір, акт, рахунок) ---
//
// One row per template — body uses {{placeholder}} substitution. Placeholders
// are resolved by the renderer service from a context object built per-render
// from the linked Rental / Client / Car / Company. Output is HTML which the
// client converts to PDF on demand.

model DocumentTemplate {
  id Int @id @default(autoincrement())

  name     String // human label
  kind     DocumentTemplateKind
  language String               @default("uk") // ISO-2 — uk | ru | en | pl | ro

  // The template body (HTML with {{placeholder}} tokens).
  bodyHtml String  @map("body_html") @db.Text
  // Optional plain-text fallback (e.g., for emails / SMS).
  bodyText String? @map("body_text") @db.Text

  // List of placeholder keys this template uses — populated by the editor
  // and validated against the renderer's known context keys at save time.
  // Stored as: ["client.fullName", "car.brand", "rental.contractNumber", ...]
  placeholders Json @default("[]")

  isActive    Boolean @default(true) @map("is_active")
  isDefault   Boolean @default(false) @map("is_default") // pick this when no template explicitly chosen for the kind
  createdById Int?    @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("DocumentTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind, language, isActive])
  @@index([isDefault])
  @@map("document_template")
}

// --- Mid-rental car swap (заміна авто без закриття договору) ---
//
// One row per swap event. Service layer flips Rental.carId to `toCarId`,
// inserts an inspection on both vehicles (out for the old car, in for the
// new), and writes this audit row. Multiple swaps per rental are allowed.

model RentalCarSwap {
  id Int @id @default(autoincrement())

  rentalId  Int      @map("rental_id")
  fromCarId Int      @map("from_car_id")
  toCarId   Int      @map("to_car_id")
  swappedAt DateTime @default(now()) @map("swapped_at")

  fromOdometer Int? @map("from_odometer") // odometer of the old car at swap
  toOdometer   Int? @map("to_odometer") // odometer of the new car at swap

  reason       String?
  notes        String?
  authorUserId Int?    @map("author_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  rental  Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  fromCar Car    @relation("CarSwapFrom", fields: [fromCarId], references: [id], onDelete: Restrict)
  toCar   Car    @relation("CarSwapTo", fields: [toCarId], references: [id], onDelete: Restrict)
  author  User?  @relation("RentalCarSwapAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([fromCarId])
  @@index([toCarId])
  @@map("rental_car_swap")
}

// --- Dynamic per-rental deposit ---
//
// Rental.depositAmount remains the standard contractual deposit. This table
// holds AD-HOC deposits a manager creates mid-rental for non-standard cases
// (e.g., extra deposit for a planned cross-border trip, holding deposit for a
// minor damage pending repair quote). Each row may be linked to a Transaction
// when actually collected.

model RentalDeposit {
  id Int @id @default(autoincrement())

  rentalId    Int                 @map("rental_id")
  reason      String // free-form label shown to client
  amountMinor Int                 @map("amount_minor")
  currency    Currency            @default(UAH)
  status      RentalDepositStatus @default(PENDING)
  dueAt       DateTime?           @map("due_at")
  receivedAt  DateTime?           @map("received_at")
  returnedAt  DateTime?           @map("returned_at")
  notes       String?

  receivedTxnId Int? @unique @map("received_txn_id") // Transaction created when funds received
  returnedTxnId Int? @unique @map("returned_txn_id") // Transaction created when funds returned

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rental      Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  receivedTxn Transaction? @relation("DepositReceivedTxn", fields: [receivedTxnId], references: [id], onDelete: SetNull)
  returnedTxn Transaction? @relation("DepositReturnedTxn", fields: [returnedTxnId], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([status])
  @@map("rental_deposit")
}
