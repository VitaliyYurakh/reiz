{
    "name": "api",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "format": "concurrently -n prettier,eslint \"npx prettier ./app --write\" \"npx eslint ./app --fix --ext .ts\"",
        "lint": "concurrently -n prettier,eslint \"npx prettier ./app -c\"  \"npx eslint ./app  --ext .ts\"",
        "dev": "npx nodemon",
        "build": "rimraf ./build && npx tsc",
        "typecheck": "npx tsc --noEmit",
        "start": "node build/app/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --config vitest.integration.config.ts"
    },
