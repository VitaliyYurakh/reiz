# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# On production generate with: openssl rand -hex 24
# If you change this after the database was already initialized, you must
# either recreate the pgdata volume (DATA LOSS) or run:
#     ALTER USER postgres WITH PASSWORD '<new>';
# inside the running container before restarting.
POSTGRES_PASSWORD=change_me_to_random_32_chars

# ─── API (Express) ──────────────────────────────────────────────────────────
API_SECRET=your_api_secret_here
API_SALT=your_api_salt_here

# ─── Next.js BFF / Auth.js ──────────────────────────────────────────────────
AUTH_SECRET=your_authjs_secret_here

# ─── Shared service-to-service secret (Next.js BFF → Express) ───────────────
SERVICE_SECRET=your_service_secret_here

# ─── Google OAuth (customer cabinet) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Cloudflare Turnstile (bot protection on public forms) ──────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ─── Telegram notifications ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
